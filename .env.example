# Copy to .env. Defaults work for a checkout at the repository root.
COS_DATABASE_URL=sqlite:///./storage/creative_os.db
COS_SNAPSHOT_ROOT=./source_snapshots/2026-10-05
COS_STORAGE_ROOT=./storage
COS_LOG_LEVEL=INFO
COS_API_HOST=127.0.0.1
COS_API_PORT=8000
COS_OPERATOR_IDENTITY=operator

# Canonical provider configuration. A real process environment variable overrides
# the same name in this file. Do not commit real credentials.
# The model has no silent fallback and is not read from a legacy variable.
# XAI_API_KEY is used only when COS_XAI_API_KEY is unset.
# OPENAI_API_KEY is used only when COS_OPENAI_API_KEY is unset.
# COS_XAI_API_KEY=
# COS_XAI_MODEL=
# COS_OPENAI_API_KEY=
# COS_OPENAI_MODEL=
COS_LIVE_TEXT_REASONING_ENABLED=false
# Default remains 10. For the first real smoke test, set this to 1 in the local environment.
COS_TEXT_REASONING_DAILY_RUN_LIMIT=10
